    {
      "key": "role-host-dispatch",
      "home": "adapters/README.md",
      "forbidden": [
        "core",
        "board",
        "intake",
        "ops",
        "roles",
        "templates",
        "manifests",
        "README.md",
        "AGENTS.md"
      ],
      "pattern": "只走宿主原生子代理|不拉 CLI 进程|不拉起 CLI 进程"
    },
    {
      "key": "vocab-mapping",
      "home": "GLOSSARY.md",
      "forbidden": [
        "core",
        "board",
        "intake",
        "ops",
        "studio",
        "engine",
