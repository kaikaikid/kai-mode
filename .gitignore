# Python 运行产物（pytest / 脚本执行生成的缓存）
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 临时目录（脚本 / 工具的中间产物）
.tmp/

# 工作树运行时数据（车道工作树本身是开发件，不入库）
.worktrees/

# WorkBuddy 工作区运行时数据（项目数据，非缓存，不入库）
.workbuddy/

# V2 执行内核运行期数据（run 状态、worktree、子会话日志）
.coding/

# Kai Mods 个人向数据（插件登记、调整记录、override）
.mods/

# 开发期间运行数据（会话/日志/数据库/验证报告/agent 数据）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.log
*.tmp
*.pid
*.jsonl
/agent-data/
/.agent-data/
/verify/
/logs/
/.cache/

# 本仓开发流水：交接／看板的日期目录与工单不进仓库（GitHub 上只留规范与模板）
# 判据正本：docs/package-layout.md
/handoff/*/[0-9][0-9][0-9][0-9]-[0-9][0-9]/
/handoff/60-board/*/*.md
/handoff/60-board/*/*/*.md
