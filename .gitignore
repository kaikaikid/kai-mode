# Python 运行产物（pytest / 脚本执行生成的缓存）
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 临时目录（脚本 / 工具的中间产物）
.tmp/

# WorkBuddy 工作区运行时数据（项目数据，非缓存，不入库）
.workbuddy/

# 开发期间运行数据（会话/日志/数据库/验证报告/agent 数据）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.log
*.tmp
*.pid
*.jsonl
/agent-data/
/.agent-data/
/verify/
/logs/
/.cache/
