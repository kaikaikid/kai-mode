{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai-mode.local/schemas/status.schema.json",
  "title": "Role status",
  "description": "状态卡只写四格＋必要指针；长叙事进日报一次。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "result", "tickets", "commits", "at"],
  "properties": {
    "schema": { "const": 1 },
    "role": { "enum": ["tower", "ground", "coordinator", "group-a", "group-b"] },
    "result": {
      "enum": [
        "working", "handoff", "no-work", "need-schedule", "need-ship",
        "blocked", "need-user", "stuck", "done", "partial", "paused"
      ]
    },
    "tickets": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "commits": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
    },
    "blocker": { "type": "string" },
    "unverified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "id"],
        "properties": {
          "role": { "enum": ["researcher", "implementer", "reviewer"] },
          "id": { "type": "string", "minLength": 1 },
          "ticket": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "at": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" }
  }
}
