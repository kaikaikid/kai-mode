{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai-mode.local/schemas/task.schema.json",
  "title": "Task runtime state",
  "description": "票的运行态正本。细状态住本机；票面内容住 GitHub Issue；合同只存哈希，不复制正文。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "ticket", "state", "contract_sha256", "attempt",
    "max_attempts", "owner", "lease_id", "branch", "updated_at"
  ],
  "properties": {
    "schema": { "const": 1 },
    "ticket": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": [
        "backlog", "ready", "claimed", "running", "validating",
        "repairing", "ship_ready", "blocked", "failed", "landed", "closed"
      ]
    },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "risk": { "enum": ["low", "medium", "high"] },
    "ship_mode": { "enum": ["direct", "pr", "hybrid"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "owner": {
      "enum": ["none", "tower", "ground", "coordinator", "group-a", "group-b"]
    },
    "lease_id": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "checkpoint": { "type": ["string", "null"] },
    "blocker": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "detail", "since"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 },
            "pointer": { "type": "string" },
            "since": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approved_by", "approved_at", "scope", "risk", "evidence"],
        "properties": {
          "approved_by": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string", "format": "date-time" },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "risk": { "enum": ["low", "medium", "high"] },
          "evidence": { "type": "string", "minLength": 1 },
          "expires_at": { "type": "string", "format": "date-time" },
          "constraints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "pr": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "head_sha", "state"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "url": { "type": "string" },
            "head_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            "state": { "enum": ["open", "merged", "closed"] }
          }
        }
      ]
    },
    "landed_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "unverified": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_action": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
