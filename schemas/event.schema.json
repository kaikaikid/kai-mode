{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai-mode.local/schemas/event.schema.json",
  "title": "Audit event",
  "description": "追加式事件日志的一行。事件只追加、不改写；不记录密钥与完整聊天记录。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "ts", "loop", "action", "actor", "result"],
  "properties": {
    "schema": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "ts": { "type": "string", "format": "date-time" },
    "loop": { "enum": ["A", "B", "C", "system"] },
    "ticket": { "type": ["integer", "null"], "minimum": 1 },
    "attempt": { "type": ["integer", "null"], "minimum": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "role": {
      "enum": [
        "user", "tower", "ground", "coordinator", "group-a", "group-b",
        "researcher", "implementer", "reviewer", "launcher", "system"
      ]
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "from_state": { "type": "string" },
    "to_state": { "type": "string" },
    "target": { "type": "string" },
    "result": { "enum": ["ok", "fail", "skip", "blocked"] },
    "reason": { "type": "string" },
    "evidence": { "type": "string" },
    "cost": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wallclock_s": { "type": "number", "minimum": 0 },
            "tokens": { "type": ["integer", "null"], "minimum": 0 },
            "tool_calls": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ]
    },
    "prev_event": { "type": ["string", "null"] }
  }
}
