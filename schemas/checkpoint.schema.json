{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai-mode.local/schemas/checkpoint.schema.json",
  "title": "Attempt checkpoint",
  "description": "一次尝试的进度快照，供接任者恢复。旧检查点只是线索，恢复时必须重跑验证。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "ticket", "attempt", "state", "branch", "commits",
    "done", "tests", "next_action", "contract_sha256", "saved_at"
  ],
  "properties": {
    "schema": { "const": 1 },
    "ticket": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": ["claimed", "running", "validating", "repairing", "ship_ready"]
    },
    "branch": { "type": "string", "minLength": 1 },
    "commits": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
    },
    "done": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "result", "at"],
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string" }
        }
      }
    },
    "current_error": { "type": ["string", "null"] },
    "next_action": { "type": "string", "minLength": 1 },
    "approvals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "context_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "threshold_mode": { "enum": ["measured", "proxy"] },
    "saved_at": { "type": "string", "format": "date-time" }
  }
}
