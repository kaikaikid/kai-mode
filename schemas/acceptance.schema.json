{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai-mode.local/schemas/acceptance.schema.json",
  "title": "Acceptance",
  "description": "跃迁批次的 AI 验收证据。verdict=pass 要求 unverified=[]；不可执行项必须显式列出。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ticket", "verdict", "checks", "unverified", "reviewer", "at"],
  "properties": {
    "schema": { "const": 1 },
    "ticket": { "type": "integer", "minimum": 1 },
    "verdict": { "enum": ["pass", "fail", "partial"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ac", "method", "result", "evidence"],
        "properties": {
          "ac": { "type": "string", "minLength": 1 },
          "method": { "enum": ["test", "run", "browser", "vlm", "measure"] },
          "result": { "enum": ["pass", "fail"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewer": { "type": "string", "minLength": 1 },
    "implementer": { "type": "string", "minLength": 1 },
    "at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
