{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex agent role manifest",
  "$comment": "口径 v3：magpie 重建的子代理 TOML 只带 name/description/developer_instructions(+可选 sandbox_mode)。model 与 model_reasoning_effort 当前由 Codex 父配置 [agents] 单点管、7 个共用 default_subagent_model，不再逐角色写进 TOML——故两者已从 required 移出，仅作未来 per-role 生效时的可选字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "developer_instructions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "developer_instructions": {
      "type": "string",
      "minLength": 100
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_reasoning_effort": {
      "enum": ["minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "sandbox_mode": {
      "enum": ["read-only", "workspace-write", "danger-full-access"]
    },
    "nickname_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9 _-]+$"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shell_tool": { "type": "boolean" },
        "apps": { "type": "boolean" },
        "plugins": { "type": "boolean" },
        "memories": { "type": "boolean" },
        "request_permissions_tool": { "type": "boolean" }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_instructions": { "type": "boolean" },
        "config": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "enabled"],
            "properties": {
              "path": { "type": "string" },
              "enabled": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
