{
  "_note": "板型「通用占位」：任意主题的清单看板（字段全是占位，装完照自己的主题改）。条目＝GitHub issues（repo 留空＝从目标仓 git remote 解析；不是 GitHub 仓就把 sources 换成 notes-jsonl / tasks-table，照 ../航班信息/board.config.example.json 抄）。标题 / 副标题 / 方向句 / 阶段名（stages）/ 字段文案（view.labels）都是占位：改 board.config.json 后用 setup_board.py --force（或 new_board.py --force）重建即生效。output.root 是板库根：要跟别的板同一个库，就改成同一个值。_note 这个键板会忽略。",
  "schema": "flight-info-board/1",
  "name": "清单",
  "title": "清单看板",
  "subtitle": "「主题」占位 · 任意主题的清单看板（板型：通用占位）",
  "repo": "",
  "output": {
    "root": "boards",
    "payload_schema": "flight-info/1"
  },
  "sources": [
    {
      "id": "issues",
      "type": "github-issues",
      "repo": "",
      "state": "open",
      "limit": 300,
      "closed_limit": 100,
      "closed_days": 1
    },
    {
      "id": "comments",
      "type": "issue-comments",
      "repo": "",
      "tickets": "auto",
      "last": 3
    }
  ],
  "stages": [
    { "key": "queued", "label": "待办" },
    { "key": "flying", "label": "进行中" },
    { "key": "closed", "label": "已完成" }
  ],
  "off_chain_stages": [
    { "key": "hold", "label": "搁置" }
  ],
  "stage_rules": [
    { "when": "state_closed", "stage": "closed" },
    { "when": "label_equals", "value": "hold", "stage": "hold" },
    { "when": "comment_contains", "value": "完成|done|办结", "stage": "closed", "why": "评论：完成", "ignore_case": true },
    { "when": "comment_contains", "value": "开始|进行|doing|wip", "stage": "flying", "why": "评论：进行中", "ignore_case": true },
    { "when": "assignee_exists", "stage": "flying", "why": "已指派 {assignee}" },
    { "when": "else", "stage": "queued" }
  ],
  "next_text": {
    "queued": "等领取",
    "flying": "推进中",
    "hold": "等解卡点",
    "closed": "已完成"
  },
  "owner_labels": {
    "unplanned": "未领"
  },
  "badges": {
    "priority": ["P0", "P1", "P2", "P3", "hold"],
    "show": ["P0", "P1", "P2", "P3", "hold"],
    "highlight": ["P0", "P1"],
    "highlight_class": "p",
    "hold_class": "hold"
  },
  "direction": {
    "template": "方向占位：先清进行中，再领待办；有搁置先解卡点。",
    "min_rows": 5,
    "target_rows": 10,
    "max_ship_list": 4
  },
  "summary": {
    "max_flights": 20,
    "max_bytes": 25600,
    "flight_stages": ["flying", "queued", "hold"],
    "flight_fields": ["number", "title", "stage", "stage_label", "next", "owner", "why", "updated"],
    "schedule_fields": ["ticket", "summary", "note"],
    "max_schedule_rows": 20
  },
  "view": {
    "search_placeholder": "搜编号 / 标题 / 经办 / 备注",
    "filters": ["flying", "queued", "hold"],
    "kpis": [
      { "cls": "fly", "key": "flying", "label": "进行中" },
      { "cls": "", "key": "queued", "label": "待办" },
      { "cls": "hold", "key": "hold", "label": "搁置" },
      { "cls": "done", "key": "closed_today", "label": "今日完成" }
    ],
    "sections": [
      { "key": "flights", "title": "清单", "hint": "阶段链：{stage_chain}" }
    ],
    "labels": {
      "head_readout": "{open} 项未完 · {in_flight} 项进行中 · {queued} 项待办",
      "direction_label": "方向",
      "col_item": "条目",
      "col_task": "内容",
      "col_stage": "阶段",
      "col_owner": "经办",
      "col_next": "下一步",
      "col_updated": "更新",
      "empty_filtered": "没有符合筛选的条目。",
      "empty_open": "没有未完成的条目。"
    }
  }
}
