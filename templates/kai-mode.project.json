{
  "schema": 2,
  "project": "<project-name>",
  "repo_root": ".",
  "ship_mode": "tower",
  "paths": {
    "day_tables": ".ai/tasks",
    "daily_report": "handoff",
    "loop_protocol": "loops/loop-protocol.md",
    "skills": "skills",
    "state_dir": ".git/kai-scope"
  },
  "execution": {
    "preferred": "qoder",
    "fallbacks": ["codex", "opencode"],
    "subagent_roles": {
      "builder": "fresh-context (own worktree + branch)",
      "reviewer": "fresh-context-independent (read-only, never the builder)",
      "utility": "support-only (env checks, gates, flaky repro; no product code)"
    },
    "host_tools": {
      "qoder": {
        "builder": "general-purpose",
        "reviewer": "general-purpose (new invocation, read-only)",
        "researcher": "Explore"
      },
      "codex": {
        "builder": "codex exec -s workspace-write",
        "reviewer": "codex exec -s read-only (separate invocation)",
        "researcher": "codex exec -s read-only"
      },
      "opencode": {
        "builder": "opencode run",
        "reviewer": "opencode run (read-only prompt, separate invocation)",
        "researcher": "opencode run (read-only prompt)"
      }
    },
    "reviewer_required_for": ["code", "schema", "high-risk"]
  },
  "runtime": {
    "backend_python": "<main-tree>/runtimes/python/Scripts/python.exe",
    "node": "<main-tree>/runtimes/node/node.exe",
    "close_gate": "python scripts/scope-check.py close-gate",
    "gate": "python scripts/framework-gate.py",
    "loop_gate": "python scripts/loop-gate.py"
  },
  "tower_cron": {
    "interval_min": 30,
    "prompt_shell": "读取并执行 skills/塔台/SKILL.md 全文；任务名 cron-tower-<日期>-<时分>",
    "output_mode": "independent",
    "execution_authorization": true,
    "job_ids_from": "<local-only config, not tracked>"
  },
  "wip": {
    "per_pilot": 2,
    "pilots": ["main", "deputy"],
    "global": 4
  },
  "limits": {
    "max_attempts": 2,
    "same_error_stop": 2,
    "task_timeout_min": 60,
    "attempt_timeout_min": 30,
    "run_timeout_min": 120,
    "circuit_breaker_failures": 3,
    "daily_wallclock_min": 480,
    "daily_token_budget": null
  },
  "approval": {
    "auto_ship_max_risk": "medium",
    "human_required": ["high"],
    "policy_changes_require_human": true
  },
  "acceptance": {
    "mode": "ai-full",
    "reviewer": "fresh-context"
  },
  "audit": {
    "events": ".git/kai-scope/events.jsonl",
    "retention_days": 30,
    "notification": [
      "task_complete",
      "approval_required",
      "repeated_failure",
      "long_blocked",
      "budget_threshold",
      "security_block"
    ]
  }
}
