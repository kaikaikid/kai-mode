{
  "schema": 1,
  "project": "<project-name>",
  "repo_root": ".",
  "ship_mode": "direct",
  "paths": {
    "plan": ".ai/scope/plan.json",
    "state_dir": ".git/kai-scope",
    "task_state_dir": ".git/kai-scope/tasks",
    "checkpoint_dir": ".git/kai-scope/checkpoints",
    "shifts": ".ai/scope/shifts",
    "activation": ".ai/scope/activation",
    "loop_protocol": "loops/loop-protocol.md"
  },
  "execution": {
    "preferred": "qoder",
    "fallbacks": ["codex", "opencode"],
    "roles": {
      "researcher": "fresh-context-read-only",
      "implementer": "fresh-context",
      "reviewer": "fresh-context-independent"
    },
    "host_tools": {
      "qoder": {
        "researcher": "Explore",
        "implementer": "general-purpose",
        "reviewer": "general-purpose (new invocation, read-only)"
      },
      "codex": {
        "researcher": "codex exec -s read-only",
        "implementer": "codex exec -s workspace-write",
        "reviewer": "codex exec -s read-only"
      },
      "opencode": {
        "researcher": "opencode run (read-only prompt)",
        "implementer": "opencode run",
        "reviewer": "opencode run (read-only prompt)"
      }
    },
    "reviewer_required_for": ["code", "schema", "high-risk"]
  },
  "runtime": {
    "plan": "python scripts/plan.py",
    "lease": "python scripts/scope-check.py",
    "token": "python scripts/on-duty-check.py",
    "gate": "python scripts/framework-gate.py",
    "close_gate": "python scripts/scope-check.py close-gate"
  },
  "activation": {
    "adapter": "child-session",
    "targets": ["tower", "ground", "group-a", "group-b"],
    "job_ids_from": ".git/kai-scope/shift-runners.local.json",
    "tested_at": null
  },
  "wip": {
    "pilot_global": 1,
    "pilot_hours": 24,
    "per_group": 2,
    "global": 4
  },
  "limits": {
    "max_attempts": 3,
    "same_error_stop": 2,
    "task_timeout_min": 60,
    "attempt_timeout_min": 30,
    "run_timeout_min": 120,
    "lease_ttl_min": 45,
    "cooldown_min": 15,
    "circuit_breaker_failures": 3,
    "daily_wallclock_min": 480,
    "daily_token_budget": null
  },
  "approval": {
    "auto_ship_max_risk": "medium",
    "human_required": ["high"],
    "policy_changes_require_human": true,
    "auto_close_low_risk_after_pilot": true
  },
  "acceptance": {
    "mode": "ai-full",
    "reviewer": "fresh-context"
  },
  "batch": {
    "ship_trigger": 2,
    "ship_interval_min": 15,
    "ship_max": 5
  },
  "audit": {
    "events": ".git/kai-scope/events.jsonl",
    "retention_days": 30,
    "notification": [
      "task_complete",
      "approval_required",
      "repeated_failure",
      "long_blocked",
      "budget_threshold",
      "security_block"
    ]
  }
}
